---
import { site } from '../content/site';
import { mmbuCitation } from '../content/citation';

const mailto = `mailto:${site.contactEmail}`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <p class="footer-mark">SPeC</p>
      <p class="footer-desc">
        The Stanford Biomedical Perception Challenge. Organized by Stanford MARVL.
      </p>
      <p class="caption">© {site.year} SPeC organizers</p>
    </div>
    <div class="footer-links">
      <nav aria-label="Footer">
        <a href="/#about">About</a>
        <a href="/#tracks">Tracks</a>
        <a href="/#timeline">Timeline</a>
        <a href="/policies/rules">Rules</a>
        <a href={site.registerUrl}>Register</a>
        <a href={mailto}>{site.contactEmail}</a>
      </nav>
      <p class="policy-slots caption">
        <a href="/policies/rules">Rules</a>
      </p>
      <details class="cite">
        <!-- Cite the benchmark. Superseded by the SPeC technical report when it exists. -->
        <summary>{mmbuCitation.label}</summary>
        <pre class="data cite-block"><code>{mmbuCitation.bibtex}</code></pre>
        <button class="btn btn-secondary copy-cite" type="button" data-cite={mmbuCitation.bibtex}>
          Copy
        </button>
      </details>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--graphite);
    color: #fff;
    padding-block: 3.5rem 2.5rem;
  }

  .site-footer a {
    color: #fff;
  }

  .site-footer a:hover {
    color: #fff;
  }

  .site-footer :focus-visible {
    outline-color: #fff;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
    text-align: center;
  }

  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      text-align: left;
      align-items: start;
    }

    .footer-links {
      justify-self: end;
      text-align: right;
    }
  }

  .footer-mark {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .footer-desc {
    max-width: 36ch;
    margin-inline: auto;
    color: rgb(255 255 255 / 0.8);
  }

  .site-footer .caption {
    color: rgb(255 255 255 / 0.7);
  }

  @media (min-width: 900px) {
    .footer-desc {
      margin-inline: 0;
    }
  }

  .footer-links nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.1rem;
    justify-content: center;
    margin-bottom: 1rem;
  }

  @media (min-width: 900px) {
    .footer-links nav {
      justify-content: flex-end;
    }
  }

  .footer-links nav a {
    text-decoration: none;
    font-weight: 500;
  }

  .policy-slots {
    margin: 0 0 1.25rem;
  }

  .cite {
    text-align: left;
  }

  .cite summary {
    cursor: pointer;
    font-weight: 500;
    list-style: none;
  }

  .cite summary::-webkit-details-marker {
    display: none;
  }

  .cite-block {
    margin: 0.75rem 0;
    padding: 0.9rem;
    background: #1a1817;
    border-radius: var(--radius-sm);
    white-space: pre-wrap;
    text-align: left;
    overflow-x: auto;
  }

  .copy-cite {
    color: #fff;
    border-color: rgb(255 255 255 / 0.4);
  }
</style>
