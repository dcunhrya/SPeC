---
interface Props {
  formula: string;
  display?: boolean;
}

import katex from 'katex';

const { formula, display = false } = Astro.props;
const html = katex.renderToString(formula, {
  displayMode: display,
  throwOnError: false,
  output: 'htmlAndMathml',
});
---

{display ? (
  <div class="formula" set:html={html} />
) : (
  <span class="math" set:html={html} />
)}
