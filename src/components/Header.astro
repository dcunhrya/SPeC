---
import { site } from '../content/site';

interface Props {
  current?: 'home' | 'register' | 'rules';
}

const { current = 'home' } = Astro.props;

const sections = [
  { id: 'about', href: '/#about', label: 'About' },
  { id: 'tracks', href: '/#tracks', label: 'Tracks' },
  { id: 'timeline', href: '/#timeline', label: 'Timeline' },
  { id: 'organizers', href: '/#organizers', label: 'Organizers' },
  { id: 'involved', href: '/#involved', label: 'Get involved' },
];
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <nav class="nav container" aria-label="Primary">
    <a class="wordmark" href="/">SPeC</a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      <span class="nav-toggle-label">Menu</span>
      <span class="nav-toggle-bars" aria-hidden="true"></span>
    </button>
    <div id="primary-nav" class="nav-panel">
      <ul class="nav-links">
        {
          sections.map((item) => (
            <li>
              <a href={item.href} data-section={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a
        class="btn btn-primary nav-register"
        href={site.registerUrl}
        aria-current={current === 'register' ? 'page' : undefined}
      >
        Register
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    min-height: var(--header-h);
    gap: 1.5rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    margin-right: auto;
  }

  .wordmark:hover {
    color: var(--cardinal);
  }

  .nav-panel {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-links {
    display: flex;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    padding: 0.2rem 0;
    border-bottom: 2px solid transparent;
  }

  .nav-links a:hover,
  .nav-links a[aria-current] {
    color: var(--cardinal);
  }

  .nav-links a[aria-current] {
    border-bottom-color: var(--cardinal);
  }

  .nav-register {
    margin-left: 0.5rem;
  }

  .nav-toggle {
    display: none;
    margin-left: auto;
    background: none;
    border: 0;
    padding: 0.4rem;
    cursor: pointer;
    color: var(--ink);
  }

  .nav-toggle-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .nav-toggle-bars,
  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: currentColor;
    position: relative;
  }

  .nav-toggle-bars::before,
  .nav-toggle-bars::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle-bars::before {
    top: -6px;
  }

  .nav-toggle-bars::after {
    top: 6px;
  }

  @media (max-width: 899px) {
    .nav-toggle {
      display: block;
    }

    .nav-panel {
      display: none;
      position: absolute;
      inset: var(--header-h) 0 auto;
      background: var(--paper);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      align-items: stretch;
      padding: 1rem 1.25rem 1.5rem;
      gap: 1rem;
    }

    .site-header.is-open .nav-panel {
      display: flex;
    }

    .nav-links {
      flex-direction: column;
      gap: 0.2rem;
    }

    .nav-links a {
      display: block;
      padding: 0.65rem 0;
    }

    .nav-register {
      margin: 0.5rem 0 0;
      align-self: flex-start;
    }
  }
</style>
