---
import { timeline, timelineNotes } from '../content/timeline';
---

<ol class="rail">
  {
    timeline.map((item) => (
      <li class:list={['rail-item', item.status]}>
        <div class="rail-node" aria-hidden="true"></div>
        <p class="rail-date data" aria-hidden={item.date ? undefined : true}>
          {item.date ?? ''}
        </p>
        <h3>{item.title}</h3>
        <p class="caption">{item.detail}</p>
      </li>
    ))
  }
</ol>
<p class="caption extra">{timelineNotes.extraMilestones}</p>
<p class="caption">{timelineNotes.officeHours}</p>

<style>
  .rail {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 900px) {
    .rail {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
      position: relative;
    }

    .rail::before {
      content: '';
      position: absolute;
      top: 0.45rem;
      left: 0.45rem;
      right: 0.45rem;
      height: 1px;
      background: var(--border);
    }
  }

  .rail-item {
    position: relative;
    padding-left: 1.6rem;
  }

  @media (min-width: 900px) {
    .rail-item {
      padding-left: 0;
      padding-top: 1.6rem;
    }
  }

  .rail-node {
    position: absolute;
    left: 0;
    top: 0.35rem;
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: var(--paper);
  }

  @media (min-width: 900px) {
    .rail-node {
      top: 0;
    }
  }

  .rail-item.done .rail-node {
    background: var(--cardinal);
    border-color: var(--cardinal);
  }

  .rail-item.current .rail-node {
    background: var(--scope);
    border-color: var(--cardinal);
  }

  .rail-item.upcoming {
    color: var(--ink-muted);
  }

  .rail-date {
    min-height: 1.35rem;
    margin: 0 0 0.35rem;
    color: var(--ink);
  }

  .rail-item h3 {
    margin: 0 0 0.35rem;
  }

  .extra {
    margin-bottom: 0.5rem;
  }
</style>
