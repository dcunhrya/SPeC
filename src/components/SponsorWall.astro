---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { sponsors, sponsorDisclosure } from '../content/sponsors';

function logoSrc(logo: string | null) {
  if (!logo) return null;
  const file = join(process.cwd(), 'public', logo.replace(/^\//, ''));
  return existsSync(file) ? logo : null;
}
---

<p>{sponsorDisclosure}</p>
<ul class="sponsor-wall">
  {
    sponsors.map((sponsor) => {
      const src = logoSrc(sponsor.logo);
      const inner = src ? (
        <img src={src} alt={sponsor.name} height="40" width="160" loading="lazy" />
      ) : (
        <span class="sponsor-name">{sponsor.name}</span>
      );
      return (
        <li>
          {sponsor.url ? (
            <a href={sponsor.url} rel="noreferrer">{inner}</a>
          ) : (
            inner
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .sponsor-wall {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2rem 2.75rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .sponsor-wall a {
    color: inherit;
    text-decoration: none;
    display: block;
  }

  .sponsor-wall img {
    height: 40px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .sponsor-wall a:hover img,
  .sponsor-wall a:focus-visible img {
    opacity: 0.8;
    transform: scale(1.04);
  }

  .sponsor-name {
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 40px;
  }
</style>
