---
import type { Track } from '../content/tracks';
import Chip from './Chip.astro';
import Math from './Math.astro';

interface Props {
  track: Track;
}

const { track } = Astro.props;
---

<article class="track-row">
  <div class="track-id">
    <p class="track-n">Track {track.n}</p>
    <h3>{track.title}</h3>
  </div>
  <div class="track-body">
    <p class="track-objective">Objective: {track.objective}</p>
    <p>{track.description}</p>
    <p class="track-chips">
      {track.chips.map((chip) => <Chip label={chip.label} value={chip.value} />)}
    </p>
    <Math formula={track.formula} display />
    {track.formulaNote && <p class="caption">{track.formulaNote}</p>}
  </div>
</article>

<style>
  .track-row {
    display: grid;
    gap: 1.25rem 2rem;
    padding: 1.75rem 0 2rem;
    border-top: 2px solid var(--cardinal);
  }

  @media (min-width: 900px) {
    .track-row {
      grid-template-columns: repeat(12, 1fr);
    }

    .track-id {
      grid-column: 1 / 5;
    }

    .track-body {
      grid-column: 5 / 13;
    }
  }

  .track-n {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--ink-muted);
  }

  .track-id h3 {
    margin: 0;
    text-wrap: balance;
  }

  .track-objective {
    font-weight: 500;
    margin-bottom: 0.65rem;
  }

  .track-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0.9rem 0 0.4rem;
  }
</style>
