---
import { collaborators, collaboratorDisclosure } from '../content/collaborators';
---

<!--
  Hard constraint: collaborators are text only.
  No logos, wordmarks, favicons, brand colors, or logo wall,
  in this section or anywhere on the site.
-->
<p>{collaboratorDisclosure}</p>
<ul class="collab-grid">
  {collaborators.map((name) => <li>{name}</li>)}
</ul>

<style>
  .collab-grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  @media (min-width: 600px) {
    .collab-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .collab-grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  .collab-grid li {
    padding: 0.85rem 0;
    border-top: 1px solid var(--border);
  }
</style>
