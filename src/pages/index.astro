---
import Base from '../layouts/Base.astro';
import SpecimenWall from '../components/SpecimenWall.astro';
import TrackRow from '../components/TrackRow.astro';
import TimelineRail from '../components/TimelineRail.astro';
import SponsorWall from '../components/SponsorWall.astro';
import CollaboratorGrid from '../components/CollaboratorGrid.astro';
import Disclosure from '../components/Disclosure.astro';
import { site } from '../content/site';
import { about, involved } from '../content/copy';
import { tracks, scoringBlurb } from '../content/tracks';
import { organizers } from '../content/organizers';
import { scoring } from '../content/scoring';

const sponsorMailto = `mailto:${site.contactEmail}?subject=${encodeURIComponent(involved.sponsor.subject)}`;
const collabMailto = `mailto:${site.contactEmail}?subject=${encodeURIComponent(involved.collaborate.subject)}`;
const generalMailto = `mailto:${site.contactEmail}`;
---

<Base current="home">
  <main id="main">
    <SpecimenWall />

    <section id="about" class="section" aria-labelledby="about-title">
      <div class="container about-grid">
        <div>
          <h2 id="about-title">About</h2>
          {about.paragraphs.map((p) => <p class="prose">{p}</p>)}
        </div>
        <aside class="callout" aria-labelledby="why-meta">
          <h3 id="why-meta" class="callout-title">{about.metadataWhy.title}</h3>
          <ul>
            {about.metadataWhy.bullets.map((item) => <li>{item}</li>)}
          </ul>
          {
            site.pdfUrl && (
              <p class="caption" style="margin-top:1rem">
                <a href={site.pdfUrl}>Download the challenge document (PDF)</a>
              </p>
            )
          }
        </aside>
      </div>
      <div class="container" style="margin-top: clamp(2.5rem, 5vw, 4rem)">
        <p class="prose">
          Evaluation runs on the
          <a href={site.mmbuUrl}>Massive Multimodal Biomedical Understanding (MMBU)</a>
          benchmark. The public development set includes open- and closed-ended VQA; the hidden
          evaluation set is open-ended only.
        </p>
        <dl class="dl">
          {
            scoring.benchmark.tasks.map((task) => (
              <div>
                <dt>{task.term}</dt>
                <dd>{task.definition}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section id="tracks" class="section section-alt" aria-labelledby="tracks-title">
      <div class="container">
        <h2 id="tracks-title">Tracks</h2>
        {tracks.map((track) => <TrackRow track={track} />)}
        <Disclosure summary="How scoring works">
          <p>{scoringBlurb.t} {scoringBlurb.c}</p>
          <p>{scoringBlurb.judge}</p>
          <p>
            <a href={scoringBlurb.rulesHref}>Read the full scoring rules</a>
          </p>
        </Disclosure>
      </div>
    </section>

    <section id="timeline" class="section" aria-labelledby="timeline-title">
      <div class="container">
        <h2 id="timeline-title">Timeline</h2>
        <TimelineRail />
      </div>
    </section>

    <section id="organizers" class="section section-alt" aria-labelledby="organizers-title">
      <div class="container">
        <h2 id="organizers-title">Organizers</h2>
        <p class="prose">{organizers.intro}</p>
        <ul class="org-grid">
          {
            organizers.committee.map((person) => (
              <li>
                <p class="org-name">{person.name}</p>
                <p class="caption">{person.affiliation}</p>
              </li>
            ))
          }
        </ul>
        <p class="caption">{organizers.heldOutNote}</p>

        <hr class="hairline block-rule" />
        <h3>Sponsors</h3>
        <SponsorWall />

        <hr class="hairline block-rule" />
        <h3>Collaborators</h3>
        <CollaboratorGrid />
      </div>
    </section>

    <section id="involved" class="section" aria-labelledby="involved-title">
      <div class="container">
        <h2 id="involved-title">Get involved</h2>
        <div class="involved-grid">
          <article class="involved-card">
            <h3>{involved.sponsor.title}</h3>
            <p>{involved.sponsor.body}</p>
            <a class="btn btn-primary" href={sponsorMailto}>{involved.sponsor.cta}</a>
          </article>
          <article class="involved-card">
            <h3>{involved.collaborate.title}</h3>
            <p>{involved.collaborate.body}</p>
            <a class="btn btn-primary" href={collabMailto}>{involved.collaborate.cta}</a>
          </article>
        </div>
        <p class="caption" style="margin-top:1.25rem">
          For general questions, email <a href={generalMailto}>{site.contactEmail}</a>.
        </p>
      </div>
    </section>
  </main>
</Base>

<style>
  .about-grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: repeat(12, 1fr);
      align-items: start;
    }

    .about-grid > div {
      grid-column: 1 / 8;
    }

    .about-grid > aside {
      grid-column: 9 / 13;
    }
  }

  .org-grid {
    list-style: none;
    margin: 2rem 0 1rem;
    padding: 0;
    display: grid;
    gap: 1.75rem 1.5rem;
  }

  @media (min-width: 600px) {
    .org-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .org-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .org-grid li {
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }

  .org-name {
    margin: 0 0 0.3rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .block-rule {
    margin: 3rem 0 1.5rem;
  }

  .involved-grid {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .involved-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .involved-card {
    background: var(--slide);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.6rem 1.65rem;
  }

  .involved-card .btn {
    margin-top: 0.9rem;
  }
</style>
